# Supply real secrets through your deployment secret manager. Never commit them.
MONGODB_URI=mongodb://127.0.0.1:27017/oushadi?replicaSet=rs0
JWT_SECRET=
BACKUP_ENCRYPTION_KEY=
# Absolute path on a persistent volume; protect access and keep off-host copies.
BACKUP_DIR=
# Set temporarily for first-owner setup, then remove and restart.
BOOTSTRAP_TOKEN=
# Enable only when your trusted proxy overwrites incoming client IP headers.
TRUST_PROXY_HEADERS=false
# Enable on one long-running Node process only.
BACKUP_SCHEDULER_ENABLED=true
# Retention is locked until a store-bound backfill and validation are completed.
# Keep disabled for the first deployment; do not enable during benchmarking.
SALES_RETENTION_CLEANUP_ENABLED=0
# At least 32 random characters; scheduler sends Authorization: Bearer <secret>.
CRON_SECRET=
